{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Backend (Python Debugger)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Frontend: Chrome (http://localhost:5173)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "Start Frontend (Vite)"
        },
        {
            "name": "Frontend: Edge (http://localhost:5173)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "Start Frontend (Vite)"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack: Backend + Frontend Chrome",
            "configurations": [
                "FastAPI Backend (Python Debugger)",
                "Frontend: Chrome (http://localhost:5173)"
            ],
            "stopAll": true
        }
    ]
}